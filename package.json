{
  "name": "agent-trust-root",
  "version": "1.0.0",
  "description": "AgentTrust root workspace",
  "private": true,
  "scripts": {
    "dev:backend": "PYTHONPATH=. uvicorn backend.main:app --reload --port 8000",
    "dev:frontend": "next dev",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test:backend": "cd backend && python3 -m pytest test_api.py",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "15.0.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.0.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
